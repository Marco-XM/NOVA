<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>NOVA</AssemblyName>
    <RootNamespace>Nova.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nova.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nova.Core\Nova.Core.csproj" />
    <ProjectReference Include="..\Nova.Platform\Nova.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\nova.ico" />
    <Resource Include="Assets\nova-tray.ico" />
    <Resource Include="Assets\nova-tray-light.ico" />
    <Resource Include="Assets\nova-256.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- A background utility should keep its heap small rather than maximize throughput. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nova.Tests" />
  </ItemGroup>
</Project>

