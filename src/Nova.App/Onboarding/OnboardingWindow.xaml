<ui:FluentWindow x:Class="Nova.App.Onboarding.OnboardingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:Nova.App.Controls"
                 Title="Welcome to NOVA"
                 Width="920" Height="680" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Assets/nova.ico">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <Style x:Key="StepTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,6,0,22" />
                <Setter Property="MaxWidth" Value="640" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="" ShowMaximize="False" />

        <Grid x:Name="Steps" Grid.Row="1" Margin="48,8,48,0">
            <!-- 1 · Welcome -->
            <StackPanel x:Name="Step1">
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <c:NotchPreview Theme="Liquid" Height="300" CornerRadius="8" />
                </Border>
                <TextBlock Text="Welcome to NOVA" Style="{StaticResource StepTitle}" FontSize="34" Margin="0,26,0,0" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="A calm, animated control center at the top of your screen. Music, quick apps, timers and system events are there when you need them and out of the way when you don't. Let's set it up in under a minute." />
            </StackPanel>

            <!-- 2 · Monitor -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock Text="Where should the notch live?" Style="{StaticResource StepTitle}" />
                <TextBlock Style="{StaticResource StepText}">
                    <Run Text="NOVA found" /> <Run Text="{Binding MonitorCount, Mode=OneWay}" /> <Run Text="monitor(s). You can change this anytime in Settings → Monitor." />
                </TextBlock>
                <UniformGrid Columns="2">
                    <RadioButton Style="{StaticResource TileRadio}" Margin="0,0,6,10" GroupName="m" IsChecked="{Binding ModePrimary}">
                        <StackPanel>
                            <TextBlock Text="Primary monitor" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Always on your main display. Simple and predictable." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TileRadio}" Margin="6,0,0,10" GroupName="m" IsChecked="{Binding ModeActive}">
                        <StackPanel>
                            <TextBlock Text="Active monitor" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Follows the window you're working in." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TileRadio}" Margin="0,0,6,10" GroupName="m" IsChecked="{Binding ModeMouse}">
                        <StackPanel>
                            <TextBlock Text="Mouse monitor" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Moves to the display your pointer is on." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TileRadio}" Margin="6,0,0,10" GroupName="m" IsChecked="{Binding ModeSelected}">
                        <StackPanel>
                            <TextBlock Text="A specific monitor" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Pick one below; NOVA remembers it even after unplugging." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding MonitorCards}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="B" Style="{StaticResource TileButton}" Padding="16,10" Margin="0,0,8,8"
                                    Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 3 · Animation -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock Text="Pick a personality" Style="{StaticResource StepTitle}" />
                <TextBlock Style="{StaticResource StepText}" Text="Every tile is a live preview. Choose the motion you like; you can fine-tune speed, bounce and accessibility later." />
                <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tile" Style="{StaticResource TileButton}" Margin="0,0,10,10"
                                    Command="{Binding DataContext.ChooseThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <c:NotchPreview Theme="{Binding Theme}" Height="120" CornerRadius="9,9,0,0" />
                                    <StackPanel Margin="14,10,14,12">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                                            <Binding Path="Theme" />
                                            <Binding Path="DataContext.Theme" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 4 · Media -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <TextBlock Text="Media integrations" Style="{StaticResource StepTitle}" />
                <TextBlock Style="{StaticResource StepText}" Text="NOVA reads what's playing through Windows' own media controls, so there's nothing to sign in to. Choose which sources can appear in the notch." />
                <c:SettingCard Glyph="&#xEC4F;" Title="Spotify" Description="{Binding SpotifyStatus}">
                    <ui:ToggleSwitch IsChecked="{Binding MediaSpotify}" />
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE774;" Title="Google Chrome" Description="{Binding ChromeStatus}">
                    <ui:ToggleSwitch IsChecked="{Binding MediaChrome}" />
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE93C;" Title="Other media apps" Description="Edge, Firefox, Media Player, VLC and other apps that publish Windows media sessions.">
                    <ui:ToggleSwitch IsChecked="{Binding MediaOther}" />
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE740;" Title="Expand briefly when music starts" Description="Shows the song for a few seconds, then settles into a small live indicator.">
                    <ui:ToggleSwitch IsChecked="{Binding MediaAutoExpand}" />
                </c:SettingCard>
            </StackPanel>

            <!-- 5 · Startup -->
            <StackPanel x:Name="Step5" Visibility="Collapsed">
                <TextBlock Text="Always ready" Style="{StaticResource StepTitle}" />
                <TextBlock Style="{StaticResource StepText}" Text="NOVA runs quietly in the background and lives in the system tray. It uses almost no CPU while idle." />
                <c:SettingCard Glyph="&#xE7E8;" Title="Launch NOVA when Windows starts" Description="Starts in the background; no window opens at sign-in. (Recommended)">
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE765;" Title="Your shortcut" Description="Open or close the notch from anywhere. You can change it in Settings → Behavior.">
                    <Border CornerRadius="6" Padding="12,6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <TextBlock Text="{Binding Hotkey}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE722;" Title="Hide the notch from screenshots" Description="Screen recordings and screen sharing won't show it.">
                    <ui:ToggleSwitch IsChecked="{Binding ExcludeFromCapture}" />
                </c:SettingCard>
            </StackPanel>

            <!-- Done -->
            <StackPanel x:Name="Step6" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B9CFF" Offset="0" />
                            <GradientStop Color="#6EE7F9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Settings.IconFont}" FontSize="32" Foreground="#0B0C10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="You're all set" Style="{StaticResource StepTitle}" HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Style="{StaticResource StepText}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Run Text="Hover the notch at the top of your screen, click it, or press" /> <Run Text="{Binding Hotkey, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                    <LineBreak /><Run Text="Right-click the tray icon for quick options." />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="48,12,48,28">
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="SkipButton" Content="Skip setup" Appearance="Transparent" Click="OnSkip" Margin="0,0,8,0" />
                <ui:Button x:Name="BackButton" Content="Back" Click="OnBack" Margin="0,0,8,0" MinWidth="96" />
                <ui:Button x:Name="NextButton" Content="Get started" Appearance="Primary" Click="OnNext" MinWidth="120" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
