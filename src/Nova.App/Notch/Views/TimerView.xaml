<UserControl x:Class="Nova.App.Notch.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource NotchTileButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,12,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Margin="-6,0,4,0" Content="&#xE72B;" ToolTip="Back"
                    Command="{Binding OpenHomeCommand}" />
            <TextBlock Text="&#xE916;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
            <TextBlock Text="Timer" Style="{StaticResource NotchText}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TimerText}" Style="{StaticResource NotchText.Digits}" FontSize="44" FontWeight="SemiBold" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding TimerIdle, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource NotchIconButton}" Width="26" Height="22" FontSize="10" Content="&#xE70E;" ToolTip="+1 minute"
                                Command="{Binding AddTimerMinutesCommand}" CommandParameter="1" />
                        <Button Style="{StaticResource NotchIconButton}" Width="26" Height="22" FontSize="10" Content="&#xE70D;" ToolTip="-1 minute"
                                Command="{Binding SubtractTimerMinuteCommand}" />
                    </StackPanel>
                </StackPanel>
                <ProgressBar Style="{StaticResource NotchProgress}" Value="{Binding TimerProgress, Mode=OneWay}" Foreground="{DynamicResource Notch.Accent}"
                             Margin="2,6,24,0" Visibility="{Binding TimerActive, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NotchIconButton}" Width="40" Height="40" FontSize="14" Content="&#xE711;" ToolTip="Cancel" Margin="0,0,8,0"
                        Command="{Binding CancelTimerCommand}" Visibility="{Binding TimerActive, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource NotchPrimaryButton}" Content="{Binding TimerPauseGlyph}" ToolTip="Pause / Resume"
                        Command="{Binding PauseResumeTimerCommand}" Visibility="{Binding TimerActive, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource NotchPrimaryButton}" Content="&#xE768;" ToolTip="Start"
                        Command="{Binding StartTimerCommand}" Visibility="{Binding TimerIdle, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding TimerIdle, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource Chip}" Content="1 min" Command="{Binding TimerPresetCommand}" CommandParameter="1" />
            <Button Style="{StaticResource Chip}" Content="5 min" Command="{Binding TimerPresetCommand}" CommandParameter="5" />
            <Button Style="{StaticResource Chip}" Content="10 min" Command="{Binding TimerPresetCommand}" CommandParameter="10" />
            <Button Style="{StaticResource Chip}" Content="25 min" Command="{Binding TimerPresetCommand}" CommandParameter="25" />
            <Button Style="{StaticResource Chip}" Content="45 min" Command="{Binding TimerPresetCommand}" CommandParameter="45" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding TimerActive, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource Chip}" Content="+1 min" Command="{Binding AddTimerMinutesCommand}" CommandParameter="1" />
            <Button Style="{StaticResource Chip}" Content="+5 min" Command="{Binding AddTimerMinutesCommand}" CommandParameter="5" />
            <TextBlock Text="Keeps running when the notch is closed" Style="{StaticResource NotchText.Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
