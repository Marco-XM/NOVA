<UserControl x:Class="Nova.App.Notch.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Nova.App.Controls">
    <Grid Margin="22,14,22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Artwork as a spinning record with a soft color-matched glow behind it -->
        <Grid Width="132" Height="132" VerticalAlignment="Center">
            <Ellipse Margin="8" Fill="{Binding MediaAccent}" Opacity="0.35">
                <Ellipse.Effect>
                    <BlurEffect Radius="22" RenderingBias="Performance" />
                </Ellipse.Effect>
            </Ellipse>
            <ctl:SpinningDisc Artwork="{Binding ArtworkImage}" Accent="{Binding MediaAccent}" IsSpinning="{Binding DiscSpinning}" />
        </Grid>

        <Grid Grid.Column="1" Margin="20,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MediaSourceGlyph}" Style="{StaticResource NotchIcon}" FontSize="11" Foreground="{Binding MediaAccent}" />
                    <TextBlock Text="{Binding MediaSource}" Style="{StaticResource NotchText.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="12" HorizontalAlignment="Right" Margin="0,-4,-8,0"
                        Content="&#xF0E2;" ToolTip="Home" Command="{Binding OpenHomeCommand}" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding MediaTitle}" Style="{StaticResource NotchText.Large}" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Text="{Binding MediaArtist}" Style="{StaticResource NotchText.Secondary}" FontSize="13" Margin="0,1,0,0" />

            <!-- Synced lyrics: the line being sung, the next one dimmed. -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,2,0,4" ClipToBounds="True"
                        Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding LyricLine}" Style="{StaticResource NotchText}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{Binding MediaAccent}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NextLyricLine}" Style="{StaticResource NotchText.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.7" />
            </StackPanel>

            <!-- Timeline -->
            <Grid Grid.Row="4" Margin="0,0,0,2" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" Style="{StaticResource NotchText.Digits}" FontSize="10.5" Foreground="{DynamicResource Notch.Tertiary}" VerticalAlignment="Center" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource NotchSlider}" Value="{Binding Progress, Mode=OneWay}"
                        IsEnabled="{Binding CanSeek}" Margin="4,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource NotchText.Digits}" FontSize="10.5" Foreground="{DynamicResource Notch.Tertiary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Controls -->
            <Grid Grid.Row="5" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <StackPanel.Resources>
                        <!-- Shuffle / repeat: dim when off, lit in the cover's color when on. -->
                        <Style x:Key="ToggleIcon" TargetType="Button" BasedOn="{StaticResource NotchIconButton}">
                            <Setter Property="Width" Value="30" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource Notch.Tertiary}" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="&#xE8B1;" ToolTip="Shuffle" Command="{Binding ToggleShuffleCommand}" Margin="0,0,2,0"
                            Visibility="{Binding CanShuffle, Converter={StaticResource BoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToggleIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShuffleActive}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding MediaAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource NotchIconButton}" Width="40" Height="40" FontSize="15" Content="&#xE892;" ToolTip="Previous"
                            Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" />
                    <Button Style="{StaticResource NotchPrimaryButton}" Margin="6,0" Content="{Binding PlayPauseGlyph}" ToolTip="Play / Pause"
                            Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanPlayPause}" />
                    <Button Style="{StaticResource NotchIconButton}" Width="40" Height="40" FontSize="15" Content="&#xE893;" ToolTip="Next"
                            Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" />
                    <Button Content="{Binding RepeatGlyph}" ToolTip="Repeat" Command="{Binding CycleRepeatCommand}" Margin="2,0,0,0"
                            Visibility="{Binding CanRepeat, Converter={StaticResource BoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToggleIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRepeatActive}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding MediaAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasSessionVolume, Converter={StaticResource BoolToVisibility}}" ToolTip="App volume">
                    <TextBlock Text="&#xE995;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Secondary}" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource NotchSlider}" Width="72" Margin="8,0,0,0"
                            Value="{Binding SessionVolume, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
