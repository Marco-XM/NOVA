<UserControl x:Class="Nova.App.Notch.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource NotchTileButton}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="{StaticResource Notch.DisplayFont}" />
            <Setter Property="Command" Value="{Binding CalcKeyCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="OpKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Foreground" Value="{DynamicResource Notch.Accent}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Margin="-2,0,4,0" Content="&#xE72B;" ToolTip="Back"
                        Command="{Binding OpenHomeCommand}" />
                <TextBlock Text="&#xE8EF;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
                <TextBlock Text="Calculator" Style="{StaticResource NotchText}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="12" HorizontalAlignment="Right" Content="&#xE8C8;" ToolTip="Copy result"
                    Command="{Binding CalcKeyCommand}" CommandParameter="copy" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="6,6,6,8">
            <TextBlock Text="{Binding CalcExpression}" Style="{StaticResource NotchText.Secondary}" FontSize="13" HorizontalAlignment="Right" TextTrimming="None" />
            <TextBlock x:Name="Result" Text="{Binding CalcResult}" Style="{StaticResource NotchText.Digits}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="4" Rows="5">
            <Button Style="{StaticResource Key}" Content="C" Foreground="{DynamicResource Notch.Danger}" />
            <Button Style="{StaticResource OpKey}" Content="(" />
            <Button Style="{StaticResource OpKey}" Content=")" />
            <Button Style="{StaticResource OpKey}" Content="÷" />
            <Button Style="{StaticResource Key}" Content="7" />
            <Button Style="{StaticResource Key}" Content="8" />
            <Button Style="{StaticResource Key}" Content="9" />
            <Button Style="{StaticResource OpKey}" Content="×" />
            <Button Style="{StaticResource Key}" Content="4" />
            <Button Style="{StaticResource Key}" Content="5" />
            <Button Style="{StaticResource Key}" Content="6" />
            <Button Style="{StaticResource OpKey}" Content="−" />
            <Button Style="{StaticResource Key}" Content="1" />
            <Button Style="{StaticResource Key}" Content="2" />
            <Button Style="{StaticResource Key}" Content="3" />
            <Button Style="{StaticResource OpKey}" Content="+" />
            <Button Style="{StaticResource Key}" CommandParameter="back" FontFamily="{StaticResource Notch.IconFont}" FontSize="14" Content="&#xE750;" />
            <Button Style="{StaticResource Key}" Content="0" />
            <Button Style="{StaticResource Key}" Content="." />
            <Button Style="{StaticResource Key}" Content="=" Background="{DynamicResource Notch.AccentSoft}" />
        </UniformGrid>
    </Grid>
</UserControl>
