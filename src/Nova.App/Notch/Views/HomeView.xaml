<UserControl x:Class="Nova.App.Notch.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Notch.Tile}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Height" Value="26" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,14,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: now playing, or the clock when nothing plays -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource NotchRowButton}" Command="{Binding OpenMediaCommand}" Margin="-10,0,8,0"
                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" ToolTip="Open player">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Notch.Tile}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource NotchIcon}" FontSize="16" Foreground="{Binding MediaAccent}" />
                            <Border CornerRadius="11" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaTitle}" Style="{StaticResource NotchText}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource NotchText.Secondary}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource NotchIconButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}"
                            IsEnabled="{Binding CanPlayPause}" ToolTip="Play / Pause" />
                </Grid>
            </Button>

            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource NotchText.Digits}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DateText}" Style="{StaticResource NotchText.Secondary}" Margin="1,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusChip}" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" ToolTip="Battery">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource NotchIcon}" FontSize="13" />
                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource NotchText.Digits}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusChip}" Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding NetworkText}">
                    <TextBlock Text="{Binding NetworkGlyph}" Style="{StaticResource NotchIcon}" FontSize="13" />
                </Border>
                <Border Style="{StaticResource StatusChip}" Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}" ToolTip="System volume (scroll over the notch to change)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VolumeGlyph}" Style="{StaticResource NotchIcon}" FontSize="13" />
                        <TextBlock Text="{Binding VolumeText}" Style="{StaticResource NotchText.Digits}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource NotchIconButton}" Width="32" Height="32" FontSize="14" Margin="6,0,-6,0" Content="&#xE713;" ToolTip="Settings"
                        Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- Quick apps -->
        <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasQuickApps, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding HomeQuickApps}" Margin="-8,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NotchAppButton}" Width="74" Height="72" ToolTip="{Binding Name}"
                                Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <Image Source="{Binding Icon}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource NotchText.Secondary}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="68" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="1" Style="{StaticResource NotchIconButton}" Width="34" Height="34" FontSize="13" Content="&#xF0E2;" ToolTip="All quick apps"
                    Command="{Binding OpenQuickAppsCommand}" VerticalAlignment="Center" />
        </Grid>

        <!-- Tools -->
        <UniformGrid Grid.Row="2" Rows="1" Margin="-3,12,-3,0" Visibility="{Binding HasTools, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource NotchTileButton}" Margin="3,0" Command="{Binding OpenToolCommand}" CommandParameter="Timer"
                    Visibility="{Binding ShowTimerTool, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" Style="{StaticResource NotchIcon}" FontSize="14" />
                    <TextBlock Text="Timer" Style="{StaticResource NotchText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NotchTileButton}" Margin="3,0" Command="{Binding OpenToolCommand}" CommandParameter="Calculator"
                    Visibility="{Binding ShowCalculatorTool, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8EF;" Style="{StaticResource NotchIcon}" FontSize="14" />
                    <TextBlock Text="Calculator" Style="{StaticResource NotchText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NotchTileButton}" Margin="3,0" Command="{Binding OpenToolCommand}" CommandParameter="Clipboard"
                    Visibility="{Binding ShowClipboardTool, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF0E3;" Style="{StaticResource NotchIcon}" FontSize="14" />
                    <TextBlock Text="Clipboard" Style="{StaticResource NotchText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NotchTileButton}" Margin="3,0" Command="{Binding OpenToolCommand}" CommandParameter="Search"
                    Visibility="{Binding ShowSearchTool, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource NotchIcon}" FontSize="14" />
                    <TextBlock Text="Search" Style="{StaticResource NotchText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
