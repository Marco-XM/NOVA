<UserControl x:Class="Nova.App.Notch.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Wordmark: a tiny gradient island + letter-spaced name. -->
        <StackPanel x:Name="Wordmark" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowWordmark, Converter={StaticResource BoolToVisibility}}" Opacity="0.62">
            <Border Width="12" Height="5" CornerRadius="2.5" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8B9CFF" Offset="0" />
                        <GradientStop Color="#6EE7F9" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Text="N O V A" Margin="7,0,0,0" FontSize="9.5" FontWeight="SemiBold" Style="{StaticResource NotchText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding TimeText}" Style="{StaticResource NotchText.Digits}" FontSize="12.5" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding ShowClockIdle, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
