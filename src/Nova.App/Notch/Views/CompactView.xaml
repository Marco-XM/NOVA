<UserControl x:Class="Nova.App.Notch.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,0,14,0">
        <!-- Media live activity -->
        <Grid x:Name="MediaPanel" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Art" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center" ClipToBounds="True" Background="{DynamicResource Notch.Tile}">
                <Grid>
                    <TextBlock Text="&#xE8D6;" Style="{StaticResource NotchIcon}" FontSize="11" Foreground="{Binding MediaAccent}" />
                    <Border CornerRadius="6" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
            <!-- Shown on hover, in the gap between the artwork and the equalizer. -->
            <StackPanel x:Name="TrackInfo" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" Opacity="0">
                <TextBlock Text="{Binding MediaTitle}" Style="{StaticResource NotchText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource NotchText.Secondary}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" />
            </StackPanel>
            <!-- Equalizer: animated while playing (24 fps to stay cheap), flat when paused. -->
            <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14">
                <StackPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="3" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="RadiusX" Value="1.5" />
                        <Setter Property="RadiusY" Value="1.5" />
                        <Setter Property="Margin" Value="1.5,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="Fill" Value="{Binding MediaAccent}" />
                    </Style>
                </StackPanel.Resources>
                <Rectangle x:Name="Bar1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar2"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar3"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar4"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
        </Grid>

        <!-- Timer live activity (only when no media is shown) -->
        <Grid x:Name="TimerPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE916;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
            <TextBlock Grid.Column="2" Text="{Binding TimerText}" Style="{StaticResource NotchText.Digits}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Notch.Accent}" />
        </Grid>
    </Grid>
</UserControl>
