<UserControl x:Class="Nova.App.Notch.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Nova.App.Controls">
    <Grid Margin="12,0,14,0">
        <!-- Media live activity -->
        <Grid x:Name="MediaPanel" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ctl:SpinningDisc x:Name="Art" Width="22" Height="22" VerticalAlignment="Center"
                              Artwork="{Binding ArtworkImage}" Accent="{Binding MediaAccent}" />
            <!-- Shown on hover, in the gap between the artwork and the equalizer. -->
            <StackPanel x:Name="TrackInfo" Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Opacity="0">
                <TextBlock Text="{Binding MediaTitle}" Style="{StaticResource NotchText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource NotchText.Secondary}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" />
            </StackPanel>
            <!-- Media controls, only while hovering. -->
            <StackPanel x:Name="Controls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0" Visibility="Collapsed">
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Content="&#xE892;" ToolTip="Previous"
                        Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" />
                <Button Style="{StaticResource NotchIconButton}" Width="30" Height="30" FontSize="13" Content="{Binding PlayPauseGlyph}" ToolTip="Play / Pause"
                        Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanPlayPause}" />
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Content="&#xE893;" ToolTip="Next"
                        Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" />
            </StackPanel>
            <!-- Unread notifications -->
            <Ellipse Grid.Column="3" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource Notch.Badge}"
                     Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}" />
            <!-- Equalizer: animated while playing (24 fps to stay cheap), flat when paused. -->
            <StackPanel x:Name="Bars" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Height="14">
                <StackPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="3" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="RadiusX" Value="1.5" />
                        <Setter Property="RadiusY" Value="1.5" />
                        <Setter Property="Margin" Value="1.5,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="Fill" Value="{Binding MediaAccent}" />
                    </Style>
                </StackPanel.Resources>
                <Rectangle x:Name="Bar1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar2"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar3"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar4"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
        </Grid>

        <!-- Timer live activity (only when no media is shown) -->
        <Grid x:Name="TimerPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE916;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
            <Ellipse Grid.Column="1" Width="6" Height="6" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource Notch.Badge}"
                     Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="2" Text="{Binding TimerText}" Style="{StaticResource NotchText.Digits}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Notch.Accent}" />
        </Grid>
    </Grid>
</UserControl>
