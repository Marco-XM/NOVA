<UserControl x:Class="Nova.App.Notch.Views.QuickAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notch="clr-namespace:Nova.App.Notch">
    <Grid Margin="20,12,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Margin="-6,0,4,0" Content="&#xE72B;" ToolTip="Back"
                        Command="{Binding OpenHomeCommand}" />
                <TextBlock Text="&#xE945;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
                <TextBlock Text="Quick Apps" Style="{StaticResource NotchText}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource NotchTileButton}" Height="28" Padding="12,0" FontSize="12" HorizontalAlignment="Right" Content="Edit"
                    Command="{Binding AddAppCommand}" ToolTip="Manage quick apps in Settings" />
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding QuickAppTiles}" Margin="-8,6,-8,0">
            <ItemsControl.Resources>
                <DataTemplate DataType="{x:Type notch:QuickAppItem}">
                    <Button Style="{StaticResource NotchAppButton}" Margin="6,0,6,12" ToolTip="{Binding Name}"
                            Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <StackPanel>
                            <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource NotchText.Secondary}" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" MaxWidth="70" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="{x:Type notch:AddAppTile}">
                    <Button Style="{StaticResource NotchAppButton}" Margin="6,0,6,12" ToolTip="Add an app"
                            Command="{Binding DataContext.AddAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="12" BorderBrush="{DynamicResource Notch.Track}" BorderThickness="1.2">
                                <TextBlock Text="&#xE710;" Style="{StaticResource NotchIcon}" FontSize="15" Foreground="{DynamicResource Notch.Secondary}" />
                            </Border>
                            <TextBlock Text="Add" Style="{StaticResource NotchText.Secondary}" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.Resources>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
