<UserControl x:Class="Nova.App.Notch.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,10,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Margin="-4,0,4,0" Content="&#xE72B;" ToolTip="Back"
                        Command="{Binding OpenHomeCommand}" />
                <TextBlock Text="&#xF0E3;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
                <TextBlock Text="Clipboard" Style="{StaticResource NotchText}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource NotchTileButton}" Height="28" Padding="12,0" FontSize="12" HorizontalAlignment="Right" Content="Clear"
                    Command="{Binding ClearClipboardCommand}" Visibility="{Binding HasClipboardItems, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource NotchScrollViewer}" Margin="-8,6,-8,0"
                      Visibility="{Binding HasClipboardItems, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding ClipboardItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button Style="{StaticResource NotchRowButton}" ToolTip="Copy again"
                                    Command="{Binding DataContext.CopyClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Grid Margin="0,0,30,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource NotchText}" FontSize="12.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding CopiedAt, StringFormat=t}" Style="{StaticResource NotchText.Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource NotchIconButton}" Width="26" Height="26" FontSize="10" HorizontalAlignment="Right" Margin="0,0,4,0" Content="&#xE711;" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasClipboardItems, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="&#xF0E3;" Style="{StaticResource NotchIcon}" FontSize="26" Foreground="{DynamicResource Notch.Tertiary}" />
            <TextBlock Text="Copied text will appear here" Style="{StaticResource NotchText.Secondary}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="Kept in memory only · skips password managers" Style="{StaticResource NotchText.Caption}" Margin="0,3,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding ClipboardFeedback}" Style="{StaticResource NotchText.Caption}" Foreground="{DynamicResource Notch.Accent}"
                   HorizontalAlignment="Center" Margin="0,6,0,0" />
    </Grid>
</UserControl>
