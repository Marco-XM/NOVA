<UserControl x:Class="Nova.App.Notch.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,10,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="11" Margin="-4,0,4,0" Content="&#xE72B;" ToolTip="Back"
                        Command="{Binding OpenHomeCommand}" />
                <TextBlock Text="&#xEA8F;" Style="{StaticResource NotchIcon}" FontSize="13" Foreground="{DynamicResource Notch.Accent}" />
                <TextBlock Text="Notifications" Style="{StaticResource NotchText}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource NotchBadge}" Margin="8,0,0,0" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource NotchBadgeText}">
                        <Run Text="{Binding UnreadCount, Mode=OneWay}" /><Run Text=" new" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <Button Style="{StaticResource NotchTileButton}" Height="28" Padding="12,0" FontSize="12" HorizontalAlignment="Right" Content="Clear all"
                    Command="{Binding ClearHistoryCommand}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource NotchScrollViewer}" Margin="-8,6,-8,0"
                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding HistoryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button Style="{StaticResource NotchRowButton}" ToolTip="Open the app"
                                    Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Grid Margin="0,0,30,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Notch.Tile}" VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NotchIcon}">
                                                        <Setter Property="Text" Value="&#xE8BD;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Notch.Accent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCall}" Value="True">
                                                                <Setter Property="Text" Value="&#xE717;" />
                                                                <Setter Property="Foreground" Value="#4ADE80" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppName}" Style="{StaticResource NotchText.Caption}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource NotchText}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Body}" Style="{StaticResource NotchText.Secondary}" FontSize="12"
                                                   Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding AgeText}" Style="{StaticResource NotchText.Caption}" HorizontalAlignment="Right" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Notch.Badge}" HorizontalAlignment="Right" Margin="0,6,1,0"
                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" ToolTip="New" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource NotchIconButton}" Width="26" Height="26" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Content="&#xE711;" ToolTip="Dismiss"
                                    Command="{Binding DataContext.DismissHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="&#xEA8F;" Style="{StaticResource NotchIcon}" FontSize="26" Foreground="{DynamicResource Notch.Tertiary}" />
            <TextBlock Text="You're all caught up" Style="{StaticResource NotchText.Secondary}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="Messages and calls from other apps appear here · kept in memory only" Style="{StaticResource NotchText.Caption}" Margin="0,3,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
