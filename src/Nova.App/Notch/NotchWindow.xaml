<Window x:Class="Nova.App.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:Nova.App.Notch.Rendering"
        Title="NOVA Notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        Width="760" Height="420"
        Focusable="False"
        UseLayoutRounding="False"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource NotchToolTip}" />
    </Window.Resources>
    <Grid x:Name="Root">
        <r:NotchShadow x:Name="Shadow" />
        <r:NotchSurface x:Name="Surface" />
        <Grid x:Name="ContentClipHost" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ContentControl x:Name="ContentHost" Focusable="False" IsTabStop="False" RenderTransformOrigin="0.5,0" />
        </Grid>
    </Grid>
</Window>
