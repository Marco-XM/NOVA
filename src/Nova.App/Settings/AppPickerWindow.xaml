<ui:FluentWindow x:Class="Nova.App.Settings.AppPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Add apps" Width="560" Height="640" MinWidth="420" MinHeight="400"
                 WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Add installed apps" ShowMinimize="False" ShowMaximize="False" />
        <ui:TextBox x:Name="Search" Grid.Row="1" Margin="20,6,20,10" PlaceholderText="Search installed apps" Icon="{ui:SymbolIcon Search24}" TextChanged="OnSearch" />
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <ListBox x:Name="List" SelectionMode="Multiple" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,4">
                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Name}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock Text="Finding installed apps…" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="20,12,20,20">
            <TextBlock x:Name="Count" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Select one or more apps" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Click="OnCancel" />
                <ui:Button x:Name="AddButton" Appearance="Primary" Content="Add" Margin="8,0,0,0" Click="OnAdd" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
