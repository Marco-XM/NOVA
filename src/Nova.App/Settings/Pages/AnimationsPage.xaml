<UserControl x:Class="Nova.App.Settings.Pages.AnimationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Nova.App.Controls">
    <StackPanel>
        <!-- Large live preview of the selected (not yet applied) theme -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <c:NotchPreview Theme="{Binding PreviewTheme}" Height="250" CornerRadius="8,8,0,0" />
                <Grid Grid.Row="1" Margin="20,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PreviewThemeDefinition.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding PreviewThemeDefinition.Description}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button Content="Preview on notch" Icon="{ui:SymbolIcon Play24}" Command="{Binding PreviewOnNotchCommand}" />
                        <ui:Button Appearance="Primary" Margin="8,0,0,0" Content="Apply" Command="{Binding ApplyPreviewCommand}"
                                   IsEnabled="{Binding PreviewIsApplied, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Text="Themes" Style="{StaticResource PageSection}" />
        <ItemsControl ItemsSource="{Binding Themes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource TileButton}" Margin="0,0,8,8" Command="{Binding DataContext.SelectPreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" x:Name="Tile">
                        <StackPanel>
                            <c:NotchPreview Theme="{Binding Theme}" Height="112" CornerRadius="9,9,0,0" />
                            <StackPanel Margin="14,10,14,12">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding Path="Theme" />
                                    <Binding Path="DataContext.PreviewTheme" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Motion" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xEC4A;" Title="Speed" Description="How quickly every transition plays.">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AnimationSpeed, StringFormat={}{0:0}%}" Style="{StaticResource ValueText}" />
                <Slider Style="{StaticResource SettingSlider}" Minimum="50" Maximum="200" TickFrequency="5" Value="{Binding AnimationSpeed}" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE9E9;" Title="Expansion duration" Description="Base duration of the expand / collapse motion.">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ExpansionDuration, StringFormat={}{0:0} ms}" Style="{StaticResource ValueText}" />
                <Slider Style="{StaticResource SettingSlider}" Minimum="150" Maximum="1200" TickFrequency="10" Value="{Binding ExpansionDuration}" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE81E;" Title="Intensity" Description="Strength of distortion, glow pulses and light sweeps.">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AnimationIntensity, StringFormat={}{0:0}%}" Style="{StaticResource ValueText}" />
                <Slider Style="{StaticResource SettingSlider}" Minimum="0" Maximum="150" TickFrequency="5" Value="{Binding AnimationIntensity}" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE9D2;" Title="Spring strength" Description="0% removes all bounce; higher values overshoot more.">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SpringStrength, StringFormat={}{0:0}%}" Style="{StaticResource ValueText}" />
                <Slider Style="{StaticResource SettingSlider}" Minimum="0" Maximum="150" TickFrequency="5" Value="{Binding SpringStrength}" />
            </StackPanel>
        </c:SettingCard>
        <TextBlock Text="Aurora light" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xE790;" Title="Aurora effect" Description="Soft, drifting colored light inside the notch. Turn it on to use it with any theme.">
            <ComboBox ItemsSource="{Binding AuroraModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AuroraMode}" MinWidth="220" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE2B1;" Title="Aurora colors" Description="Shades of your accent color, or three colors of your own.">
            <c:SettingCard.Footer>
                <StackPanel Visibility="{Binding AuroraUsesCustomColors, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{Binding AuroraBrush1}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                        <ui:TextBox Text="{Binding AuroraColor1, UpdateSourceTrigger=LostFocus}" Width="104" Margin="8,0,16,0" PlaceholderText="#RRGGBB" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{Binding AuroraBrush2}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                        <ui:TextBox Text="{Binding AuroraColor2, UpdateSourceTrigger=LostFocus}" Width="104" Margin="8,0,16,0" PlaceholderText="#RRGGBB" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{Binding AuroraBrush3}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                        <ui:TextBox Text="{Binding AuroraColor3, UpdateSourceTrigger=LostFocus}" Width="104" Margin="8,0,0,0" PlaceholderText="#RRGGBB" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Quick picks (fills the next slot):" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ItemsControl ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="24" Height="24" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding}"
                                            Command="{Binding DataContext.AddAuroraPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{Binding}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </c:SettingCard.Footer>
            <ComboBox ItemsSource="{Binding AuroraColorSources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AuroraColorSource}" MinWidth="220" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE8D6;" Title="Match the cover art" Description="While music or a video with cover art plays, the Aurora takes its colors from the artwork.">
            <ui:ToggleSwitch IsChecked="{Binding AuroraFollowsArtwork}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE706;" Title="Ambient light when idle" Description="Lets the Aurora light keep drifting in the resting pill. Uses a little GPU continuously.">
            <ui:ToggleSwitch IsChecked="{Binding AmbientWhenIdle}" />
        </c:SettingCard>

        <TextBlock Text="Accessibility" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xE776;" Title="Reduce motion" Description="Replaces springs and distortion with quick, simple fades and scales.">
            <ui:ToggleSwitch IsChecked="{Binding ReduceMotion}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE7F8;" Title="Follow Windows animation setting" Description="Reduce motion automatically when 'Animation effects' is off in Windows Settings → Accessibility.">
            <ui:ToggleSwitch IsChecked="{Binding FollowSystemReduceMotion}" />
        </c:SettingCard>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Reset motion settings" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetAnimationCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
