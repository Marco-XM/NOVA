<UserControl x:Class="Nova.App.Settings.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Nova.App.Controls">
    <StackPanel>
        <TextBlock Text="Performance" Style="{StaticResource PageSection}" Margin="2,0,0,8" />
        <Border Style="{StaticResource Card}">
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="CPU" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding CpuText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Private memory" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding PrivateMemoryText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Working set" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding MemoryText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Animation" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding FpsText}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding RefreshRateText}" Style="{StaticResource Secondary}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Managed heap" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding GcText}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Process" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding ThreadsText}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding UptimeText, StringFormat=Up {0}}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </UniformGrid>
        </Border>
        <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,0" Text="The settings window itself uses extra memory and CPU for its live previews; both drop once it's closed." />

        <TextBlock Text="Diagnostics" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xEBE8;" Title="Debug mode" Description="Enables developer commands sent with NOVA.exe --debug and extra diagnostics.">
            <ui:ToggleSwitch IsChecked="{Binding DebugMode}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE9F9;" Title="Verbose logging" Description="Writes detailed state transitions to the log.">
            <ui:ToggleSwitch IsChecked="{Binding VerboseLogging}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE8A5;" Title="Logs" Description="{Binding LogPath}">
            <c:SettingCard.Footer>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Show recent entries" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding RefreshLogCommand}" />
                        <ui:Button Content="Open logs folder" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsCommand}" />
                    </StackPanel>
                    <TextBox Text="{Binding RecentLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,10,0,0"
                             MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             Visibility="{Binding RecentLog, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </c:SettingCard.Footer>
        </c:SettingCard>

        <TextBlock Text="Settings" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xE713;" Title="Settings file" Description="{Binding SettingsPath}">
            <ui:Button Content="Open folder" Command="{Binding OpenSettingsFolderCommand}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE768;" Title="Welcome tour" Description="Run the first-run setup again.">
            <ui:Button Content="Start" Command="{Binding RunOnboardingCommand}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE72C;" Title="Reset settings" Description="Restore every setting to its default. Quick apps are kept.">
            <ui:Button Content="Reset…" Appearance="Danger" Command="{Binding ResetSettingsCommand}" />
        </c:SettingCard>

        <TextBlock Text="About" Style="{StaticResource PageSection}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding VersionText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding OsText}" Style="{StaticResource Secondary}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" Text="Built with WPF on .NET 8, WPF-UI, H.NotifyIcon, NAudio and CommunityToolkit.Mvvm." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
