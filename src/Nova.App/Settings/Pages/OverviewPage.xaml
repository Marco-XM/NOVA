<UserControl x:Class="Nova.App.Settings.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Nova.App.Controls">
    <StackPanel>
        <!-- Hero: live preview of the current theme -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <c:NotchPreview Theme="{Binding Theme}" Height="230" CornerRadius="8,0,0,8" />
                <StackPanel Grid.Column="1" Margin="24,22" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#5FD68A" VerticalAlignment="Center" />
                        <TextBlock Text="Running" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding UptimeText, StringFormat=' · {0}'}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ThemeName}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Current animation theme" Style="{StaticResource Secondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <ui:Button Appearance="Primary" Content="Open the notch" Command="{Binding ExpandNotchCommand}" />
                        <ui:Button Content="Test event" Margin="8,0,0,0" Command="{Binding TestNotificationCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Status" Style="{StaticResource PageSection}" />
        <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,4,4">
                <StackPanel>
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Settings.IconFont}" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Monitor" Margin="0,10,0,0" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding CurrentMonitorText}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentMonitorReason}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,0,4">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Settings.IconFont}" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Media" Margin="0,10,0,0" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" Margin="0,2,90,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding NowPlayingSubtitle}" Style="{StaticResource Secondary}" Margin="0,2,90,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding HasNowPlaying, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Appearance="Transparent" Padding="8" Command="{Binding NowPlayingPreviousCommand}">
                            <TextBlock Text="&#xE892;" FontFamily="{StaticResource Settings.IconFont}" />
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Padding="8" Command="{Binding NowPlayingToggleCommand}">
                            <TextBlock Text="{Binding NowPlayingGlyph}" FontFamily="{StaticResource Settings.IconFont}" />
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Padding="8" Command="{Binding NowPlayingNextCommand}">
                            <TextBlock Text="&#xE893;" FontFamily="{StaticResource Settings.IconFont}" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,4,4">
                <StackPanel>
                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource Settings.IconFont}" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Shortcut" Margin="0,10,0,0" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding Hotkey}" FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,0,4">
                <StackPanel>
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Settings.IconFont}" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Resource use" Margin="0,10,0,0" Style="{StaticResource Secondary}" />
                    <TextBlock FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="{Binding CpuText, Mode=OneWay}" /><Run Text=" CPU · " /><Run Text="{Binding PrivateMemoryText, Mode=OneWay}" /><Run Text=" memory" />
                    </TextBlock>
                    <TextBlock Text="Idle CPU should stay near 0%" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Quick controls" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xE7B3;" Title="Show notch" Description="Hide it any time from here, the tray, or with the shortcut.">
            <ui:ToggleSwitch IsChecked="{Binding NotchVisible}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE7E8;" Title="Launch NOVA when Windows starts" Description="{Binding StartupStatusText}">
            <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
        </c:SettingCard>
        <c:SettingCard Glyph="&#xE945;" Title="Animation theme" Description="Pick one here, or explore live previews on the Animations page.">
            <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Name" SelectedValuePath="Theme" SelectedValue="{Binding Theme}" MinWidth="180" />
        </c:SettingCard>
    </StackPanel>
</UserControl>
