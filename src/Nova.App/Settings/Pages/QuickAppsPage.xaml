<UserControl x:Class="Nova.App.Settings.Pages.QuickAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Nova.App.Controls">
    <StackPanel>
        <WrapPanel>
            <ui:Button Appearance="Primary" Content="Add installed app" Icon="{ui:SymbolIcon Apps24}" Margin="0,0,8,8" Click="OnAddInstalled" />
            <ui:Button Content="Browse for app" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,8" Command="{Binding AddExecutableCommand}" />
            <ui:Button Content="Add folder" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,8" Command="{Binding AddFolderCommand}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:TextBox Text="{Binding NewWebsiteUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Website, e.g. github.com" Width="220" />
                <ui:Button Content="Add site" Icon="{ui:SymbolIcon Globe24}" Margin="6,0,0,0" Command="{Binding AddWebsiteCommand}" />
            </StackPanel>
        </WrapPanel>
        <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,12"
                   Text="Drag rows (or use the arrows) to reorder. The first six appear on the notch's home panel; all appear in Quick Apps. Give an app a shortcut to launch it from anywhere." />

        <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding HasQuickApps, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Settings.IconFont}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No quick apps yet" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Add your favorite apps to launch them from the notch." Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="List" ItemsSource="{Binding QuickApps}" AllowDrop="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10" Tag="{Binding}" Cursor="SizeAll"
                            PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseMove="OnRowMouseMove" Drop="OnRowDrop" AllowDrop="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE76F;" FontFamily="{StaticResource Settings.IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="2" Margin="14,0,12,0" VerticalAlignment="Center" Cursor="Arrow">
                                <TextBox Text="{Binding Name, Mode=OneWay}" Tag="{Binding}" LostFocus="OnRename" KeyDown="OnRenameKey" FontSize="14"
                                         BorderThickness="0" Background="Transparent" Padding="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="Click to rename" />
                                <TextBlock Text="{Binding Target}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="This app can't be found at its saved location" FontSize="12" Foreground="#FF9A8A"
                                           Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding HotkeyError, StringFormat=Shortcut unavailable: {0}}" FontSize="12" Foreground="#FFB86B"
                                           Visibility="{Binding HotkeyError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                            <c:HotkeyBox Grid.Column="3" Value="{Binding Hotkey, Mode=OneWay}" Tag="{Binding}" MinWidth="150" Margin="0,0,10,0" Cursor="Hand"
                                         Committed="OnHotkeyCommitted" RecordingChanged="OnRecordingChanged" ToolTip="Shortcut to launch this app (Backspace clears)" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Cursor="Arrow">
                                <ui:Button Appearance="Transparent" Padding="8" ToolTip="Open" Command="{Binding DataContext.LaunchQuickAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Settings.IconFont}" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="8" ToolTip="Choose icon" Command="{Binding DataContext.ChooseIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Settings.IconFont}" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="8" ToolTip="Move up" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Settings.IconFont}" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="8" ToolTip="Move down" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Settings.IconFont}" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="8" ToolTip="Remove" Command="{Binding DataContext.RemoveQuickAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Settings.IconFont}" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
