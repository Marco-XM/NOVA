<UserControl x:Class="Nova.App.Settings.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Nova.App.Controls">
    <StackPanel>
        <!-- Monitor map: mirrors the Windows display arrangement -->
        <Border Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding MonitorCards}" Width="{Binding MapWidth}" Height="{Binding MapHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding MapX}" />
                            <Setter Property="Canvas.Top" Value="{Binding MapY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="{Binding MapWidth}" Height="{Binding MapHeight}" Cursor="Hand" ToolTip="Use this monitor"
                                    Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Border Width="30" Height="6" CornerRadius="3" VerticalAlignment="Top" Margin="0,4,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Notch is on" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding CurrentMonitorText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentMonitorReason}" Style="{StaticResource Secondary}" Margin="0,2,0,12" />
                    <TextBlock Style="{StaticResource Secondary}" Text="Click a monitor to pin the notch to it. The accent bar marks where it is right now." />
                    <ui:Button Content="Identify monitors" Icon="{ui:SymbolIcon NumberSymbolSquare24}" Margin="0,14,0,0" Command="{Binding IdentifyMonitorsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Monitor mode" Style="{StaticResource PageSection}" />
        <UniformGrid Columns="2">
            <RadioButton Style="{StaticResource TileRadio}" Margin="0,0,4,8" GroupName="mode" IsChecked="{Binding ModePrimary}">
                <StackPanel>
                    <TextBlock Text="Primary monitor" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Always on the display Windows marks as main." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource TileRadio}" Margin="4,0,0,8" GroupName="mode" IsChecked="{Binding ModeSelected}">
                <StackPanel>
                    <TextBlock Text="Selected monitor" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Pinned to the monitor you chose above; falls back to primary while it's disconnected." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource TileRadio}" Margin="0,0,4,8" GroupName="mode" IsChecked="{Binding ModeActive}">
                <StackPanel>
                    <TextBlock Text="Active monitor" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Follows the window you're working in." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource TileRadio}" Margin="4,0,0,8" GroupName="mode" IsChecked="{Binding ModeMouse}">
                <StackPanel>
                    <TextBlock Text="Mouse monitor" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Moves to whichever monitor the pointer is on." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <TextBlock Text="Scaling &amp; position" Style="{StaticResource PageSection}" />
        <c:SettingCard Glyph="&#xE7B5;" Title="DPI handling" Description="NOVA is Per-Monitor DPI aware (v2). It positions the notch in physical pixels and re-places it whenever scaling, resolution or the monitor layout changes, so it stays centered at 100%, 125%, 150%, 200% or mixed scaling." />
        <c:SettingCard Glyph="&#xE81E;" Title="Disconnects and sleep" Description="Your choice is remembered by the monitor's hardware ID. If it's unplugged the notch moves to the primary display and returns automatically when it's reconnected or after waking from sleep." />
    </StackPanel>
</UserControl>
